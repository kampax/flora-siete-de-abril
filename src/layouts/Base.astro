---
import '../styles/global.css';
import { url } from '../lib';

interface Props {
  titulo: string;
  descripcion?: string;
}
const { titulo, descripcion = 'Relevamiento fotográfico de la flora de Siete de Abril: nativas, exóticas, cactáceas y hierbas, con nombre popular y científico.' } = Astro.props;
const completo = titulo === 'Flora de Siete de Abril' ? titulo : `${titulo} · Flora de Siete de Abril`;

const enlaces = [
  ['Catálogo', 'catalogo/'],
  ['Mapa', 'mapa/'],
  ['Familias', 'familias/'],
  ['Por identificar', 'por-identificar/'],
  ['El lugar', 'el-lugar/'],
  ['Colaborar', 'colaborar/'],
  ['Créditos', 'creditos/'],
];
const actual = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{completo}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={completo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="sitio">
      <div class="contenedor">
        <a class="marca" href={url()} aria-label="Flora de Siete de Abril, inicio">
          <svg viewBox="0 0 40 48" fill="none" aria-hidden="true"><path d="M20 43V12M20 29C5 30 5 15 5 15S20 14 20 29ZM20 21C34 22 35 5 35 5S20 6 20 21Z" stroke="currentColor" stroke-width="1.6"/></svg>
          <span>Flora <i>de</i> Siete de Abril<small>UN REGISTRO BOTÁNICO LOCAL</small></span>
        </a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="navegacion" type="button">Menú <span aria-hidden="true">☰</span></button>
        <nav id="navegacion" aria-label="Principal">
          {enlaces.map(([t, h]) => (
            <a href={url(h)} aria-current={actual.endsWith('/' + h) ? 'page' : undefined}>{t}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="contenido" class="contenedor">
      <slot />
    </main>
    <footer class="sitio">
      <div class="contenedor">
        <div><a class="footer-brand" href={url()}>Flora de Siete de Abril</a><p>Conocer lo que crece cerca.</p></div>
        <div class="footer-creditos">Fotografías de Natalia Paz<br/>Identificación de Carlos Navarro<br/><a href={url('creditos/')}>Créditos y licencia ↗</a></div>
      </div>
    </footer>
  </body>
</html>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector('header nav');
  toggle?.addEventListener('click', () => {
    const abierto = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(abierto));
    nav?.classList.toggle('abierto', abierto);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      toggle.setAttribute('aria-expanded', 'false'); nav?.classList.remove('abierto'); toggle.focus();
    }
  });
</script>
